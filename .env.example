# Local-only, disposable infrastructure defaults. Do not put secrets here.
CHEFFY_DB_NAME=cheffybites
CHEFFY_DB_USERNAME=cheffybites
CHEFFY_DB_PASSWORD=local-development-only
CHEFFY_DB_PORT=5432
CHEFFY_MAILPIT_SMTP_PORT=1025
CHEFFY_MAILPIT_HTTP_PORT=8025
CHEFFY_ALLOWED_ORIGINS=http://localhost:3000
CHEFFY_OTEL_EXPORT_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Reserved for the later identity slice. T01 does not load or use these values.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
