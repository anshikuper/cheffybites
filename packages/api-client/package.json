{
  "name": "@cheffybites/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "validate": "redocly lint --config ../../redocly.yaml",
    "generate": "../../backend/gradlew -p ../../backend generateApiClient"
  },
  "devDependencies": {
    "@redocly/cli": "2.51.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
