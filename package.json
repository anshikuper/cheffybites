{
  "name": "cheffy-bites",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint . --max-warnings 0 && pnpm --recursive --if-present lint",
    "type-check": "pnpm --recursive --if-present type-check",
    "test": "pnpm --recursive --if-present test",
    "test:coverage": "pnpm --recursive --if-present test:coverage",
    "test:e2e": "pnpm --filter @cheffybites/customer-web test:e2e",
    "openapi:validate": "pnpm --filter @cheffybites/api-client validate",
    "api-client:generate": "pnpm --filter @cheffybites/api-client generate",
    "api-client:drift": "node tools/check-api-client-drift.mjs",
    "verify:metadata": "node tools/verify-foundation-metadata.mjs",
    "verify": "pnpm verify:metadata && pnpm openapi:validate && pnpm api-client:drift && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "infra:config": "docker compose --project-name cheffybites config --quiet",
    "infra:up": "docker compose --project-name cheffybites up --detach --wait",
    "infra:down": "docker compose --project-name cheffybites down",
    "infra:reset:local": "docker compose --project-name cheffybites down --volumes --remove-orphans"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "16.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
